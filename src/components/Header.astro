---
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/collections/', label: 'Collections' },
  { href: '/oral-histories/', label: 'Oral Histories' },
  { href: '/schools/', label: 'Schools' },
  { href: '/courses/', label: 'Courses' },
  { href: '/timeline/', label: 'Timeline' },
  { href: '/archive/', label: 'Archive' },
  { href: '/people/', label: 'People' },
  { href: '/about/', label: 'About' },
  { href: '/get-involved/', label: 'Get Involved' }
];
const primaryLinks = links.slice(0, 2);
const sectionLinks = links.slice(2);
const isCurrent = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <div class="utility-bar">A community archive in active development</div>
  <div class="nav-wrap">
    <a class="wordmark" href="/" aria-label="Delaware Cross Country Archive home">
      <span class="wordmark-mark" aria-hidden="true">DXC</span>
      <span>Delaware Cross Country<br /><strong>Archive</strong></span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul class="nav-primary">
        {primaryLinks.map((link) => (
          <li><a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
      <ul class="nav-sections">
        {sectionLinks.map((link) => (
          <li><a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <details class="mobile-nav">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        <ul>
          {links.map((link) => (
            <li><a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

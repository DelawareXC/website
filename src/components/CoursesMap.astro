---
import { courses } from '../data/courses';

const courseMapData = JSON.stringify(courses);
---

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="anonymous" />

<section class="courses-map-section" aria-labelledby="courses-map-heading">
  <div class="container">
    <div class="courses-map-header">
      <div>
        <p class="section-kicker light">Interactive course atlas</p>
        <h2 id="courses-map-heading">Delaware statewide view</h2>
        <p>Field-walked course routes are now mapped. Additional routes will be added one at a time after review.</p>
      </div>
      <button id="reset-delaware-view" class="map-reset" type="button">Reset Delaware view</button>
    </div>

    <div class="courses-map-frame">
      <div
        id="delaware-courses-map"
        class="courses-map"
        role="region"
        aria-label="Interactive map centered on the state of Delaware"
        data-courses={courseMapData}
      ></div>
      <noscript>
        <p class="map-fallback">JavaScript is required to use the interactive Delaware course map.</p>
      </noscript>
    </div>

    <div class="map-notes">
      <p><strong>Map controls:</strong> drag to move, use the plus and minus buttons to zoom, and select a street or topographic base map.</p>
      <p class="map-legend">
        <span class="legend-endpoint legend-start" aria-hidden="true">S</span> Starting Point
        <span class="legend-endpoint legend-finish" aria-hidden="true">F</span> Finish Point
      </p>
      <p id="map-load-status" role="status">Loading the interactive Delaware map and course routes…</p>
    </div>
  </div>
</section>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin="anonymous"></script>
<script is:inline>
  (() => {
    const mapElement = document.getElementById('delaware-courses-map');
    const resetButton = document.getElementById('reset-delaware-view');
    const status = document.getElementById('map-load-status');

    if (!mapElement || mapElement.dataset.initialized === 'true') return;

    if (!window.L) {
      if (status) status.textContent = 'The interactive map could not be loaded. Please refresh the page and try again.';
      return;
    }

    mapElement.dataset.initialized = 'true';
    const courseData = JSON.parse(mapElement.dataset.courses || '[]');

    const delawareBounds = window.L.latLngBounds(
      [38.42, -75.79],
      [39.84, -74.98]
    );

    const mapBounds = window.L.latLngBounds(
      [38.15, -76.08],
      [40.05, -74.68]
    );

    const map = window.L.map(mapElement, {
      zoomControl: true,
      scrollWheelZoom: false,
      keyboard: true,
      minZoom: 7,
      maxBounds: mapBounds,
      maxBoundsViscosity: 1
    });

    const street = window.L.tileLayer(
      'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
      {
        attribution: '&copy; OpenStreetMap contributors',
        maxZoom: 19
      }
    );

    const topographic = window.L.tileLayer(
      'https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png',
      {
        attribution: 'Map data &copy; OpenStreetMap contributors | Map style &copy; OpenTopoMap',
        maxZoom: 17
      }
    );

    const courseLayer = window.L.layerGroup().addTo(map);
    const endpointLayer = window.L.layerGroup().addTo(map);

    topographic.addTo(map);
    window.L.control.layers(
      { 'Topographic': topographic, 'Street': street },
      { 'Course routes': courseLayer, 'Start & finish': endpointLayer },
      { position: 'topright', collapsed: window.innerWidth < 700 }
    ).addTo(map);
    window.L.control.scale({ imperial: true, metric: false }).addTo(map);

    let loadedRoutes = 0;

    courseData.forEach((course) => {
      let routeLayer = null;
      const marker = window.L.circleMarker(course.marker, {
        radius: 8,
        color: '#f2eee4',
        weight: 2,
        fillColor: '#3388ff',
        fillOpacity: 1
      }).addTo(courseLayer);

      const popup = document.createElement('div');
      popup.className = 'course-map-popup';

      const label = document.createElement('p');
      label.className = 'course-map-popup-label';
      label.textContent = course.status;

      const name = document.createElement('strong');
      name.textContent = course.name;

      const location = document.createElement('p');
      location.textContent = course.location;

      const distance = document.createElement('p');
      distance.textContent = course.distance;

      const note = document.createElement('p');
      note.className = 'course-map-popup-note';
      note.textContent = course.note;

      const viewRoute = document.createElement('button');
      viewRoute.type = 'button';
      viewRoute.textContent = 'View complete route';
      viewRoute.disabled = true;
      viewRoute.addEventListener('click', () => {
        if (routeLayer) map.fitBounds(routeLayer.getBounds(), { padding: [36, 36] });
      });

      popup.append(label, name, location, distance, note, viewRoute);
      marker.bindPopup(popup, { maxWidth: 310 });
      marker.bindTooltip(course.name, { direction: 'top', offset: [0, -8] });

      fetch(course.routeUrl)
        .then((response) => {
          if (!response.ok) throw new Error(`Route request failed: ${response.status}`);
          return response.json();
        })
        .then((route) => {
          routeLayer = window.L.geoJSON(route, {
            style: {
              color: '#3388ff',
              weight: 4,
              opacity: .92,
              lineJoin: 'round',
              lineCap: 'round'
            }
          }).addTo(courseLayer);
          routeLayer.bindTooltip(course.name, { sticky: true });
          routeLayer.on('click', () => marker.openPopup());

          const coordinates = route?.geometry?.coordinates;
          if (Array.isArray(coordinates) && coordinates.length > 1) {
            const start = coordinates[0];
            const finish = coordinates[coordinates.length - 1];

            const startIcon = window.L.divIcon({
              className: 'course-endpoint-icon course-start-icon',
              html: '<span aria-hidden="true">S</span>',
              iconSize: [22, 22],
              iconAnchor: [11, 11],
              popupAnchor: [0, -11]
            });

            const finishIcon = window.L.divIcon({
              className: 'course-endpoint-icon course-finish-icon',
              html: '<span aria-hidden="true">F</span>',
              iconSize: [22, 22],
              iconAnchor: [11, 11],
              popupAnchor: [0, -11]
            });

            const makeEndpointPopup = (title) => {
              const content = document.createElement('div');
              content.className = 'course-endpoint-popup';
              const heading = document.createElement('strong');
              heading.textContent = title;
              const courseName = document.createElement('span');
              courseName.textContent = course.name;
              content.append(heading, courseName);
              return content;
            };

            window.L.marker([start[1], start[0]], {
              icon: startIcon,
              title: `Starting Point — ${course.name}`,
              alt: `Starting Point for ${course.name}`,
              keyboard: true,
              zIndexOffset: 1000
            })
              .bindPopup(makeEndpointPopup('Starting Point'))
              .bindTooltip('Starting Point', { direction: 'top', offset: [0, -11] })
              .addTo(endpointLayer);

            window.L.marker([finish[1], finish[0]], {
              icon: finishIcon,
              title: `Finish Point — ${course.name}`,
              alt: `Finish Point for ${course.name}`,
              keyboard: true,
              zIndexOffset: 1100
            })
              .bindPopup(makeEndpointPopup('Finish Point'))
              .bindTooltip('Finish Point', { direction: 'top', offset: [0, -11] })
              .addTo(endpointLayer);
          }

          viewRoute.disabled = false;
          loadedRoutes += 1;
          if (status) {
            const routeLabel = loadedRoutes === 1 ? 'course route' : 'course routes';
            status.textContent = `${loadedRoutes} field-walked ${routeLabel} ready. Select a marker or route for details.`;
          }
        })
        .catch(() => {
          if (status) status.textContent = 'The course marker is ready, but its route line could not be loaded. Please refresh the page and try again.';
        });
    });

    const resetView = () => map.fitBounds(delawareBounds, { padding: [24, 24] });
    resetView();

    resetButton?.addEventListener('click', resetView);
    window.addEventListener('resize', () => map.invalidateSize());

    if (status && courseData.length === 0) status.textContent = 'Interactive Delaware map ready. No course routes are currently published.';
  })();
</script>

<style>
  .courses-map-section {
    padding: clamp(4.5rem, 8vw, 7rem) 0;
    background: var(--forest-dark);
    color: var(--white);
  }

  .courses-map-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    margin-bottom: 2rem;
    align-items: end;
    gap: 3rem;
  }

  .courses-map-header h2 { color: var(--paper); }
  .courses-map-header p:last-child { max-width: 680px; margin-bottom: 0; color: #cbd3cd; }

  .map-reset {
    padding: .8rem 1rem;
    border: 1px solid #718078;
    background: transparent;
    color: var(--white);
    cursor: pointer;
    font-size: .78rem;
    font-weight: 600;
  }

  .map-reset:hover { border-color: var(--gold); color: var(--gold); }

  .courses-map-frame {
    position: relative;
    overflow: hidden;
    border: 1px solid #718078;
    background: #dce2d7;
    box-shadow: 0 20px 50px rgba(5, 13, 9, .28);
  }

  .courses-map { width: 100%; height: clamp(480px, 62vw, 690px); }

  .map-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    padding: 2rem;
    margin: 0;
    background: var(--paper);
    color: var(--forest);
    text-align: center;
    place-items: center;
  }

  .map-notes {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    padding-top: 1rem;
    color: #bfc9c2;
    gap: 2rem;
  }

  .map-notes p { max-width: 560px; margin: 0; font-size: .72rem; }
  .map-notes strong { color: var(--paper); }
  .legend-endpoint { display: inline-grid; width: 20px; height: 20px; margin: 0 .3rem 0 .55rem; border: 2px solid var(--white); border-radius: 50%; color: var(--white); font-size: .62rem; font-weight: 700; line-height: 1; vertical-align: middle; place-items: center; }
  .legend-endpoint:first-child { margin-left: 0; }
  .legend-start { background: #2f7d4a; }
  .legend-finish { background: #b33c2f; }

  :global(.course-endpoint-icon) { position: relative; display: block; box-sizing: border-box; border: 2px solid var(--white); border-radius: 50%; color: var(--white); box-shadow: 0 1px 5px rgba(12, 25, 17, .38); font: 700 .62rem/1 var(--sans); }
  :global(.course-endpoint-icon > span) { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; padding: 0; margin: 0; line-height: 1; text-align: center; }
  :global(.course-start-icon) { background: #2f7d4a; }
  :global(.course-finish-icon) { background: #b33c2f; }
  :global(.course-endpoint-popup) { min-width: 150px; color: var(--ink); font-family: var(--sans); }
  :global(.course-endpoint-popup strong) { display: block; color: var(--forest); font: 500 1rem/1.2 var(--serif); }
  :global(.course-endpoint-popup span) { display: block; margin-top: .3rem; color: var(--muted); font-size: .7rem; }

  :global(.course-map-popup) { min-width: 230px; color: var(--ink); font-family: var(--sans); }
  :global(.course-map-popup strong) { display: block; margin-bottom: .45rem; color: var(--forest); font: 500 1.1rem/1.2 var(--serif); }
  :global(.course-map-popup p) { margin: 0 0 .45rem; font-size: .72rem; line-height: 1.45; }
  :global(.course-map-popup .course-map-popup-label) { color: var(--clay); font-size: .62rem; font-weight: 600; letter-spacing: .09em; text-transform: uppercase; }
  :global(.course-map-popup .course-map-popup-note) { padding-top: .5rem; border-top: 1px solid var(--line); color: var(--muted); }
  :global(.course-map-popup button) { width: 100%; padding: .55rem .7rem; margin-top: .4rem; border: 0; background: var(--forest); color: var(--white); cursor: pointer; font-size: .7rem; font-weight: 600; }
  :global(.course-map-popup button:disabled) { opacity: .5; cursor: wait; }

  :global(.courses-map .leaflet-control-layers),
  :global(.courses-map .leaflet-bar a) {
    border-color: #a9b2aa;
    color: var(--forest);
    font-family: var(--sans);
  }

  :global(.courses-map .leaflet-control-attribution) {
    color: #4c554e;
    font-size: .64rem;
  }

  @media (max-width: 700px) {
    .courses-map-header { grid-template-columns: 1fr; gap: 1.2rem; }
    .map-reset { width: max-content; }
    .courses-map { height: 520px; }
    .map-notes { grid-template-columns: 1fr; gap: .65rem; }
  }

  @media (max-width: 430px) {
    .courses-map { height: 460px; }
  }
</style>

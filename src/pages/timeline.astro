---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { timelineMilestones } from '../data/timeline';

const eras = [
  { label: '1960s', href: '#dssaa-established-1966' },
  { label: '1970s', href: '#boys-cross-country-championship-1970' },
  { label: '2000s', href: '#diaa-replaces-dssaa-2002' },
  { label: '2020s', href: '#division-structure-2020' }
];
---

<BaseLayout title="Timeline" description="A developing, source-based chronology of Delaware cross country from the nineteenth century to the present.">
  <section class="detail-header timeline-header">
    <div class="container narrow">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Timeline' }]} />
      <p class="eyebrow light">A developing chronology</p>
      <h1>Timeline</h1>
      <p class="lead">Selected milestones in the governance, championships, and preservation of Delaware cross country history.</p>
      <p class="timeline-disclaimer">Historical entries below are based on official Delaware Interscholastic Athletic Association sources. This chronology will continue to grow as additional records are reviewed.</p>
    </div>
  </section>

  <nav class="era-navigation" aria-label="Timeline eras">
    <div class="container">
      <span>Jump to an era</span>
      <ul>{eras.map((era) => <li><a href={era.href}>{era.label}</a></li>)}</ul>
    </div>
  </nav>

  <section class="section timeline-section" aria-labelledby="timeline-heading">
    <div class="container">
      <div class="section-heading timeline-intro">
        <div>
          <p class="section-kicker">Verified milestones</p>
          <h2 id="timeline-heading">A developing historical record</h2>
        </div>
        <p>Select a milestone to expand its historical context and source information.</p>
      </div>

      <ol class="timeline-list">
        {timelineMilestones.map((milestone, index) => (
          <li id={milestone.id} class="timeline-entry">
            <div class="timeline-marker" aria-hidden="true"><span>{milestone.icon}</span></div>
            <details class="timeline-card" open={index === 0}>
              <summary>
                <span class="timeline-date">{milestone.dateLabel}</span>
                <span class="timeline-summary-main">
                  <span class="timeline-category">{milestone.category}</span>
                  <strong>{milestone.title}</strong>
                  <span>{milestone.summary}</span>
                </span>
                <span class="timeline-toggle" aria-hidden="true"></span>
              </summary>
              <div class="timeline-card-content">
                <h3>Milestone details</h3>
                <ul>{milestone.details.map((detail) => <li>{detail}</li>)}</ul>
                {milestone.sourceUrl && milestone.sourceLabel && (
                  <a class="timeline-source-link" href={milestone.sourceUrl} target="_blank" rel="noreferrer">
                    Source: {milestone.sourceLabel} <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </details>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="review-notice timeline-method-note">
    <div class="container narrow">
      <p class="section-kicker light">How the chronology will grow</p>
      <h2>Evidence before certainty.</h2>
      <p>Additional entries will distinguish documented events from interpretation, cite sources, preserve uncertainty, and link to related oral histories, people, schools, trails, and archival records when those materials are ready.</p>
    </div>
  </section>
</BaseLayout>
